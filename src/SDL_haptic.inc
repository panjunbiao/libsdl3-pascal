{ SDL_haptic.inc -- 1-to-1 from SDL_haptic.h (SDL 3.4.16) }

type
  SDL_Haptic = record
  end;
  PSDL_Haptic = ^SDL_Haptic;
  PPSDL_Haptic = ^PSDL_Haptic;
  SDL_HapticEffectType = Uint16;
  PSDL_HapticEffectType = ^SDL_HapticEffectType;
  PPSDL_HapticEffectType = ^PSDL_HapticEffectType;
  SDL_HapticDirectionType = Uint8;
  PSDL_HapticDirectionType = ^SDL_HapticDirectionType;
  PPSDL_HapticDirectionType = ^PSDL_HapticDirectionType;
  SDL_HapticEffectID = Integer;
  PSDL_HapticEffectID = ^SDL_HapticEffectID;
  PPSDL_HapticEffectID = ^PSDL_HapticEffectID;
  PSDL_HapticDirection = ^SDL_HapticDirection;
  PPSDL_HapticDirection = ^PSDL_HapticDirection;
  SDL_HapticDirection = record
    type_: SDL_HapticDirectionType;
    dir: array[0..2] of Sint32;
  end;
  PSDL_HapticConstant = ^SDL_HapticConstant;
  PPSDL_HapticConstant = ^PSDL_HapticConstant;
  SDL_HapticConstant = record
    type_: SDL_HapticEffectType;
    direction: SDL_HapticDirection;
    length: Uint32;
    delay: Uint16;
    button: Uint16;
    interval: Uint16;
    level: Sint16;
    attack_length: Uint16;
    attack_level: Uint16;
    fade_length: Uint16;
    fade_level: Uint16;
  end;
  PSDL_HapticPeriodic = ^SDL_HapticPeriodic;
  PPSDL_HapticPeriodic = ^PSDL_HapticPeriodic;
  SDL_HapticPeriodic = record
    type_: SDL_HapticEffectType;
    direction: SDL_HapticDirection;
    length: Uint32;
    delay: Uint16;
    button: Uint16;
    interval: Uint16;
    period: Uint16;
    magnitude: Sint16;
    offset: Sint16;
    phase: Uint16;
    attack_length: Uint16;
    attack_level: Uint16;
    fade_length: Uint16;
    fade_level: Uint16;
  end;
  PSDL_HapticCondition = ^SDL_HapticCondition;
  PPSDL_HapticCondition = ^PSDL_HapticCondition;
  SDL_HapticCondition = record
    type_: SDL_HapticEffectType;
    direction: SDL_HapticDirection;
    length: Uint32;
    delay: Uint16;
    button: Uint16;
    interval: Uint16;
    right_sat: array[0..2] of Uint16;
    left_sat: array[0..2] of Uint16;
    right_coeff: array[0..2] of Sint16;
    left_coeff: array[0..2] of Sint16;
    deadband: array[0..2] of Uint16;
    center: array[0..2] of Sint16;
  end;
  PSDL_HapticRamp = ^SDL_HapticRamp;
  PPSDL_HapticRamp = ^PSDL_HapticRamp;
  SDL_HapticRamp = record
    type_: SDL_HapticEffectType;
    direction: SDL_HapticDirection;
    length: Uint32;
    delay: Uint16;
    button: Uint16;
    interval: Uint16;
    start: Sint16;
    end_: Sint16;
    attack_length: Uint16;
    attack_level: Uint16;
    fade_length: Uint16;
    fade_level: Uint16;
  end;
  PSDL_HapticLeftRight = ^SDL_HapticLeftRight;
  PPSDL_HapticLeftRight = ^PSDL_HapticLeftRight;
  SDL_HapticLeftRight = record
    type_: SDL_HapticEffectType;
    length: Uint32;
    large_magnitude: Uint16;
    small_magnitude: Uint16;
  end;
  PSDL_HapticCustom = ^SDL_HapticCustom;
  PPSDL_HapticCustom = ^PSDL_HapticCustom;
  SDL_HapticCustom = record
    type_: SDL_HapticEffectType;
    direction: SDL_HapticDirection;
    length: Uint32;
    delay: Uint16;
    button: Uint16;
    interval: Uint16;
    channels: Uint8;
    period: Uint16;
    samples: Uint16;
    data: PUint16;
    attack_length: Uint16;
    attack_level: Uint16;
    fade_length: Uint16;
    fade_level: Uint16;
  end;
  PSDL_HapticEffect = ^SDL_HapticEffect;
  PPSDL_HapticEffect = ^PSDL_HapticEffect;
  SDL_HapticEffect = record
    case Integer of
      0: (type_: SDL_HapticEffectType);
      1: (constant: SDL_HapticConstant);
      2: (periodic: SDL_HapticPeriodic);
      3: (condition: SDL_HapticCondition);
      4: (ramp: SDL_HapticRamp);
      5: (leftright: SDL_HapticLeftRight);
      6: (custom: SDL_HapticCustom);
  end;
  SDL_HapticID = Uint32;
  PSDL_HapticID = ^SDL_HapticID;
  PPSDL_HapticID = ^PSDL_HapticID;

const
  SDL_HAPTIC_INFINITY = Uint32($FFFFFFFF);
  SDL_HAPTIC_CONSTANT = 1 shl 0;
  SDL_HAPTIC_SINE = 1 shl 1;
  SDL_HAPTIC_SQUARE = 1 shl 2;
  SDL_HAPTIC_TRIANGLE = 1 shl 3;
  SDL_HAPTIC_SAWTOOTHUP = 1 shl 4;
  SDL_HAPTIC_SAWTOOTHDOWN = 1 shl 5;
  SDL_HAPTIC_RAMP = 1 shl 6;
  SDL_HAPTIC_SPRING = 1 shl 7;
  SDL_HAPTIC_DAMPER = 1 shl 8;
  SDL_HAPTIC_INERTIA = 1 shl 9;
  SDL_HAPTIC_FRICTION = 1 shl 10;
  SDL_HAPTIC_LEFTRIGHT = 1 shl 11;
  SDL_HAPTIC_RESERVED1 = 1 shl 12;
  SDL_HAPTIC_RESERVED2 = 1 shl 13;
  SDL_HAPTIC_RESERVED3 = 1 shl 14;
  SDL_HAPTIC_CUSTOM = 1 shl 15;
  SDL_HAPTIC_GAIN = 1 shl 16;
  SDL_HAPTIC_AUTOCENTER = 1 shl 17;
  SDL_HAPTIC_STATUS = 1 shl 18;
  SDL_HAPTIC_PAUSE = 1 shl 19;
  SDL_HAPTIC_POLAR = 0;
  SDL_HAPTIC_CARTESIAN = 1;
  SDL_HAPTIC_SPHERICAL = 2;
  SDL_HAPTIC_STEERING_AXIS = 3;

