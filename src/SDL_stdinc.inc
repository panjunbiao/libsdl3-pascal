{ SDL_stdinc.inc -- 1-to-1 from SDL_stdinc.h (SDL 3.4.14) }

type
  { Delphi type names are case-insensitive; do not alias Uint8 = UInt8. }
  Sint8 = ShortInt;
  Uint8 = Byte;
  Sint16 = SmallInt;
  Uint16 = Word;
  Sint32 = Integer;
  Uint32 = Cardinal;
  Sint64 = Int64;
  Uint64 = System.UInt64;
  SDL_Time = Sint64;

  PSint8 = ^Sint8;
  PUint8 = ^Uint8;
  PSint16 = ^Sint16;
  PUint16 = ^Uint16;
  PSint32 = ^Sint32;
  PUint32 = ^Uint32;
  PSint64 = ^Sint64;
  PUint64 = ^Uint64;
  PNativeUInt = ^NativeUInt;
  PPUint8 = ^PUint8;
  PPUTF8Char = ^PUTF8Char;
  PBoolean = ^Boolean;

  SDL_FunctionPointer = procedure; cdecl;

  PPointer = ^Pointer;
  PPWideChar = ^PWideChar;

  SDL_malloc_func = function(size: NativeUInt): Pointer; cdecl;
  PSDL_malloc_func = ^SDL_malloc_func;
  SDL_calloc_func = function(nmemb, size: NativeUInt): Pointer; cdecl;
  PSDL_calloc_func = ^SDL_calloc_func;
  SDL_realloc_func = function(mem: Pointer; size: NativeUInt): Pointer; cdecl;
  PSDL_realloc_func = ^SDL_realloc_func;
  SDL_free_func = procedure(mem: Pointer); cdecl;
  PSDL_free_func = ^SDL_free_func;

  SDL_Environment = record
  end;
  PSDL_Environment = ^SDL_Environment;

  SDL_CompareCallback = function(a, b: Pointer): Integer; cdecl;
  SDL_CompareCallback_r = function(userdata, a, b: Pointer): Integer; cdecl;

  { SDL_iconv_t is already a pointer in C. }
  SDL_iconv_t = Pointer;

const
  SDL_MAX_SINT8 = Sint8($7F);
  SDL_MIN_SINT8 = Sint8(-128);
  SDL_MAX_UINT8 = Uint8($FF);
  SDL_MIN_UINT8 = Uint8(0);
  SDL_MAX_SINT16 = Sint16($7FFF);
  SDL_MIN_SINT16 = Sint16(-32768);
  SDL_MAX_UINT16 = Uint16($FFFF);
  SDL_MIN_UINT16 = Uint16(0);
  SDL_MAX_SINT32 = Sint32($7FFFFFFF);
  SDL_MIN_SINT32 = Sint32(-2147483647 - 1);
  SDL_MAX_UINT32 = Uint32($FFFFFFFF);
  SDL_MIN_UINT32 = Uint32(0);
  SDL_MAX_SINT64 = Sint64($7FFFFFFFFFFFFFFF);
  SDL_MIN_SINT64 = Sint64(-9223372036854775807 - 1);
  SDL_MAX_UINT64 = Uint64($FFFFFFFFFFFFFFFF);
  SDL_MIN_UINT64 = Uint64(0);
  SDL_MAX_TIME = SDL_MAX_SINT64;
  SDL_MIN_TIME = SDL_MIN_SINT64;
  SDL_FLT_EPSILON = 1.1920928955078125E-07;
  SDL_PI_D = 3.141592653589793238462643383279502884;
  SDL_PI_F = 3.14159265358979323846;
  SDL_ICONV_ERROR = NativeUInt(-1);
  SDL_ICONV_E2BIG = NativeUInt(-2);
  SDL_ICONV_EILSEQ = NativeUInt(-3);
  SDL_ICONV_EINVAL = NativeUInt(-4);

