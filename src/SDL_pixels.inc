type
  PSDL_Color = ^SDL_Color;
  SDL_Color = record
    r: Uint8;
    g: Uint8;
    b: Uint8;
    a: Uint8;
  end;

  PSDL_FColor = ^SDL_FColor;
  SDL_FColor = record
    r: Single;
    g: Single;
    b: Single;
    a: Single;
  end;

  PSDL_Palette = ^SDL_Palette;
  SDL_Palette = record
    ncolors: Integer;
    colors: PSDL_Color;
    version: Uint32;
    refcount: Integer;
  end;

  PSDL_PixelFormatDetails = ^SDL_PixelFormatDetails;
  SDL_PixelFormatDetails = record
    format: SDL_PixelFormat;
    bits_per_pixel: Uint8;
    bytes_per_pixel: Uint8;
    padding: array[0..1] of Uint8;
    Rmask: Uint32;
    Gmask: Uint32;
    Bmask: Uint32;
    Amask: Uint32;
    Rbits: Uint8;
    Gbits: Uint8;
    Bbits: Uint8;
    Abits: Uint8;
    Rshift: Uint8;
    Gshift: Uint8;
    Bshift: Uint8;
    Ashift: Uint8;
  end;

